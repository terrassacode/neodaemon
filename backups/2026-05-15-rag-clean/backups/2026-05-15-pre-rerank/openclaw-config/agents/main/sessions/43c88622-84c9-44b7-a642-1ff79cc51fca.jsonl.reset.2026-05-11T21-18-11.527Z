cd \"${DASHBOARD_DIR}/..\" && pwd)\"\nPORT=\"8765\"\nURL=\"http://127.0.0.1:${PORT}/dashboard/\"\nPIDFILE=\"/tmp/neodaemon-dashboard.pid\"\nLOGFILE=\"/tmp/neodaemon-dashboard.log\"\n\nif ! command -v python3 >/dev/null 2>&1; then\n  zenity --error --text=\"Python3 no está instalado. No puedo abrir el dashboard local.\" 2>/dev/null || echo \"Python3 no está instalado.\"\n  exit 1\nfi\n\nserver_ok() {\n  curl -fsS \"http://127.0.0.1:${PORT}/dashboard/\" >/dev/null 2>&1 \\\n    && curl -fsS \"http://127.0.0.1:${PORT}/health/blood_pressure/2026/05/11.jsonl\" >/dev/null 2>&1\n}\n\nport_pid() {\n  ss -ltnp 2>/dev/null \\\n    | awk -v port=\":${PORT}\" '$4 ~ port { print $NF }' \\\n    | sed -n 's/.*pid=\\([0-9][0-9]*\\).*/\\1/p' \\\n    | head -1\n}\n\nstart_server() {\n  nohup python3 -m http.server \"${PORT}\" --bind 127.0.0.1 --directory \"${WORKSPACE_DIR}\" >\"${LOGFILE}\" 2>&1 &\n  echo \"$!\" >\"${PIDFILE}\"\n  sleep 0.8\n}\n\nif ss -ltn 2>/dev/null | grep -q \":${PORT} \"; then\n  if ! server_ok; then\n    PID=\"$(port_pid || true)\"\n    if [ -n \"${PID}\" ] && tr '\\0' ' ' <\"/proc/${PID}/cmdline\" 2>/dev/null | grep -q \"python3 -m http.server ${PORT}\"; then\n      kill \"${PID}\" 2>/dev/null || true\n      sleep 0.5\n      start_server\n    else\n      echo \"El puerto ${PORT} está ocupado por otro proceso. No puedo reiniciar el dashboard de forma segura.\"\n      echo \"Cierra el proceso que usa ${PORT} y vuelve a abrir el dashboard.\"\n      exit 1\n    fi\n  fi\nelse\n  start_server\nfi\n\nif command -v xdg-open >/dev/null 2>&1; then\n  xdg-open \"${URL}\" >/dev/null 2>&1 &\nelif command -v firefox >/dev/null 2>&1; then\n  firefox \"${URL}\" >/dev/null 2>&1 &\nelse\n  echo \"Abre esta dirección en el navegador: ${URL}\"\nfi\n"}}],"api":"openai-codex-responses","provider":"openai-codex","model":"gpt-5.5","usage":{"input":860,"output":1125,"cacheRead":57856,"cacheWrite":0,"totalTokens":59841,"cost":{"input":0.0043,"output":0.03375,"cacheRead":0.028928,"cache