{"type":"message","id":"38d153d8","parentId":"c82a010b","timestamp":"2026-05-14T07:41:20.601Z","message":{"role":"toolResult","toolCallId":"call_cjk8nVG2F3WUgCb3b1ly0EMW|fc_0d75942cb9a8c0e2016a057ca0861081918ec6e938d3c6e2f4","toolName":"read","content":[{"type":"text","text":"          <div class=\"mini-card compact\">\n            <h3>Estabilidad</h3>\n            <div class=\"metric\"><span>Score</span><strong>sin snapshot</strong></div>\n            <div class=\"metric\"><span>Errores críticos</span><strong>sin fuente</strong></div>\n            <div class=\"metric\"><span>Reinicios gateway</span><strong>sin fuente</strong></div>\n            <div class=\"source\">\n              Fuente futura: <code>data/metrics/stability/</code><br />\n              Estado: <span class=\"pill placeholder\">no_disponible</span>\n            </div>\n          </div>\n\n          <div class=\"mini-card compact full\" id=\"last-event\">\n            <h3>Último evento</h3>\n            <div class=\"metric\"><span>Última acción</span><strong id=\"last_action\">sin datos</strong></div>\n            <div class=\"metric\"><span>Último estado</span><strong id=\"last_status\">sin datos</strong></div>\n            <div class=\"metric\"><span>Duración</span><strong><span id=\"last_duration\">sin datos</span> ms</strong></div>\n            <div class=\"source\">\n              Fuente: <code>data/last_event.json</code><br />\n              Estado: <span class=\"pill real\">real</span>\n            </div>\n          </div>\n\n          <div class=\"mini-card compact full\" id=\"daily-summary\">\n            <h3>Resumen diario</h3>\n            <div class=\"metric\"><span>Total</span><strong id=\"total\">sin datos</strong></div>\n            <div class=\"metric\"><span>Éxitos</span><strong id=\"success\">sin datos</strong></div>\n            <div class=\"metric\"><span>Fallos</span><strong id=\"fail\">sin datos</strong></div>\n            <div class=\"metric\"><span>Duración media</span><strong><span id=\"avg\">sin datos</span> ms</strong></div>\n            <div class=\"source\">\n              Fuente: <code>data/daily_summary.json</code><br />\n              Estado: <span class=\"pill real\">real</span>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      <div class=\"dashboard-block\">\n        <h2>Sistema documental</h2>\n        <div class=\"block-grid fill\">\n          <div class=\"mini-card compact\">\n            <h3>Tools / plugins</h3>\n            <div class=\"metric\"><span>Plugins</span><strong>sin auditoría</strong></div>\n            <div class=\"metric\"><span>Tools</span><strong>sin inventario</strong></div>\n            <div class=\"metric\"><span>Acciones</span><strong>no disponibles</strong></div>\n            <div class=\"source\">\n              Fuente futura: <code>data/metrics/tools_plugins/</code><br />\n              Estado: <span class=\"pill placeholder\">no_disponible</span>\n            </div>\n          </div>\n\n          <div class=\"mini-card compact\">\n            <h3>Fuentes locales previstas</h3>\n            <ul class=\"small\">\n              <li><code>data/metrics/</code></li>\n              <li><code>data/health/</code></li>\n              <li><code>data/snapshots/</code></li>\n              <li><code>memory/YYYY-MM-DD.md</code></li>\n            </ul>\n            <div class=\"source\">\n              Política: <span class=\"pill policy\">local</span> <span class=\"pill policy\">privado</span> <span class=\"pill policy\">read-only</span>\n            </div>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    <footer>\n      Dashboard v2 estático. Si un dato no tiene fuente verificable, se muestra como “sin datos”, “sin snapshot” o “no disponible”.\n    </footer>\n  </main>\n\n  <script>\n    function renderLastEventFallback() {\n      document.getElementById('last_action').textContent = 'sin datos';\n      document.getElementById('last_status').textContent = 'sin datos';\n      document.getElementById('last_duration').textContent = 'sin datos';\n    }\n\n    function renderDailySummaryFallback() {\n      document.getElementById('total').textContent = 'sin datos';\n      document.getElementById('success').textContent = 'sin datos';\n      document.getElementById('fail').textContent = 'sin datos';\n      document.getElementById('avg').textContent = 'sin datos';\n    }\n\n    function refreshLastEvent() {\n      fetch('data/last_event.json', { cache: 'no-store' })\n        .then(response => {\n          if (!response.ok) throw new Error(`HTTP ${response.status}`);\n          return response.json();\n        })\n        .then(data => {\n          document.getElementById('last_action').textContent = data.action ?? 'sin datos';\n          document.getElementById('last_status').textContent = data.status ?? 'sin datos';\n          document.getElementById('last_duration').textContent = data.duration_ms ?? 'sin datos';\n        })\n        .catch(error => {\n          console.error('Error cargando data/last_event.json:', error);\n          renderLastEventFallback();\n        });\n    }\n\n    function refreshDailySummary() {\n      fetch('data/daily_summary.json', { cache: 'no-store' })\n        .then(response => {\n          if (!response.ok) throw new Error(`HTTP ${response.status}`);\n          return response.json();\n        })\n        .then(data => {\n          document.getElementById('total').textContent = data.total ?? 'sin datos';\n          document.getElementById('success').textContent = data.success ?? 'sin datos';\n          document.getElementById('fail').textContent = data.fail ?? 'sin datos';\n          document.getElementById('avg').textContent = data.avg_duration_ms ?? 'sin datos';\n        })\n        .catch(error => {\n          console.error('Error cargando data/daily_summary.json:', error);\n          renderDailySummaryFallback();\n        });\n    }\n\n    refreshLastEvent();\n    refreshDailySummary();\n    setInterval(refreshLastEvent, 5000);\n    setInterval(refreshDailySummary, 5000);\n  </script>\n</body>\n</html>\n"}],"isError":false,"timestamp":1778744480601}}
