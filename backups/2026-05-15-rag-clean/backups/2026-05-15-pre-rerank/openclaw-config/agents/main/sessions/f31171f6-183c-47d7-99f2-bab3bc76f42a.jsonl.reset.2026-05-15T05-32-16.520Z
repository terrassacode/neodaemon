{"type":"message","id":"3625b765","parentId":"b6f815cf","timestamp":"2026-05-14T19:57:27.484Z","message":{"role":"toolResult","toolCallId":"call_aeOmvfyEZcjRxiexNVci3ZDD|fc_0d75942cb9a8c0e2016a062927672c81918acfa578db1661c6","toolName":"read","content":[{"type":"text","text":"<!doctype html>\n<html lang=\"es\">\n<head>\n  <meta charset=\"utf-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Neodaemon · Dashboard v2</title>\n  <style>\n    :root {\n      color-scheme: dark;\n      --bg: #0d1117;\n      --panel: #161b22;\n      --panel-2: #1f2630;\n      --panel-soft: rgba(31, 38, 48, .55);\n      --text: #e6edf3;\n      --muted: #8b949e;\n      --accent: #58a6ff;\n      --ok: #3fb950;\n      --warn: #d29922;\n      --border: #30363d;\n    }\n\n    * { box-sizing: border-box; }\n\n    body {\n      margin: 0;\n      font-family: system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;\n      background:\n        radial-gradient(circle at top left, rgba(88, 166, 255, .08), transparent 34vw),\n        var(--bg);\n      color: var(--text);\n      line-height: 1.45;\n    }\n\n    main {\n      width: 100vw;\n      max-width: none;\n      min-height: 100vh;\n      margin: 0;\n      padding: 10px 12px 16px;\n    }\n\n[639 more lines in file. Use offset=41 to continue.]"}],"isError":false,"timestamp":1778788647484}}
{"type":"message","id":"1958516a","parentId":"3625b765","timestamp":"2026-05-14T19:57:27.485Z","message":{"role":"toolResult","toolCallId":"call_l038oYGWiwjlTunD4LZnYq7b|fc_0d75942cb9a8c0e2016a0629276740819186f41f0297ac4f8d","toolName":"read","content":[{"type":"text","text":"          box.innerHTML = '';\n\n          if (!results.length) {\n            box.innerHTML = '<p>Sin resultados</p>';\n            return;\n          }\n\n          results.forEach(item => {\n            box.innerHTML += `\n              <div style=\"border:1px solid #333;padding:10px;margin-bottom:10px;border-radius:8px;\">\n                <strong>${item.title}</strong><br>\n                <small>Score: ${item.score.toFixed(3)}</small><br>\n                <p>${item.preview}</p>\n                <a href=\"${item.url}\" target=\"_blank\">Abrir fuente</a>\n              </div>\n            `;\n          });\n        })\n        .catch(err => {\n          console.error('Fetch error:', err);\n          document.getElementById('rag_results').textContent = 'Error: ' + err;\n        });\n    };\n\n    function loadRagStats() {\n      fetch(API_BASE_URL + '/rag-stats?token=' + API_TOKEN)\n        .then(r => r.json())\n        .then(d => {\n          const txt = `RAG → total:${d.total} | high:${d.confidence.high} | medium:${d.confidence.medium} | low:${d.confidence.low}`;\n          document.body.insertAdjacentHTML('afterbegin', `<div style=\"background:#111;padding:10px;color:#0f0\">${txt}</div>`);\n        });\n    }\n\n    refreshDashboardData();\n    setInterval(refreshDashboardData, 5000);\n    loadRagStats();\n  </script>\n</body>\n</html>\n"}],"isError":false,"timestamp":1778788647484}}
