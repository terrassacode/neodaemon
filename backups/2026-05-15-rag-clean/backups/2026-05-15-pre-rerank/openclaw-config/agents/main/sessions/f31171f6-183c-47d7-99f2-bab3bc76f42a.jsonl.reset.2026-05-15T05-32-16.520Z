Call = function(endpoint) {\n+      fetch('http://100.117.135.114:5000' + endpoint + '?token=neodaemon123')\n+        .then(response => response.text())\n+        .then(data => {\n+          document.getElementById('action_result').textContent = data;\n+        })\n+        .catch(error => {\n+          document.getElementById('action_result').textContent = 'Error: ' + error;\n+        });\n+    };\n   </script>\n </body>\n </html>\n-\n-<div style=\"padding:20px;\">\n-  <h2>Control</h2>\n-  <button onclick=\"apiCall(\"/summary\")\">Ver resumen</button>\n-</div>\n-\n-\n-<script>\n-function apiCall(\"/summary\") {\n-  fetch('http://100.117.135.114:5000/summary')\n-    .then(r => r.text())\n-    .then(data => alert(data))\n-    .catch(err => alert('Error: ' + err));\n-}\n-</script>\n-\n-\n-<div style=\"padding:20px;\">\n-  <h3>Resultado API</h3>\n-  <pre id=\"api_result\" style=\"background:#111;padding:10px;border-radius:6px;\"></pre>\n-</div>\n-\n-\n-<script>\n-function apiCall(\"/summary\") {\n-  fetch('http://100.117.135.114:5000/summary')\n-    .then(r => r.text())\n-    .then(data => {\n-      document.getElementById('api_result').textContent = data;\n-    })\n-    .catch(err => {\n-      document.getElementById('api_result').textContent = \"Error: \" + err;\n-    });\n-}\n-</script>\n-\n-<div style=\"padding:20px;\">\n-  <h2>Acciones</h2>\n-  <button onclick=\"apiCall('/summary')\">Resumen</button>\n-  <button onclick=\"apiCall('/last-events')\">Últimos eventos</button>\n-  <button onclick=\"apiCall('/restart-dashboard')\">Reiniciar dashboard</button>\n-  <button onclick=\"apiCall('/restart-gateway')\">Reiniciar gateway</button>\n-  <pre id=\"action_result\"></pre>\n-</div>\n-\n-<script>\n-\n-<script>\n-window.API_TOKEN = \"neodaemon123\";\n-\n-window.apiCall = function(endpoint) {\n-  fetch('http://100.117.135.114:5000' + endpoint + '?token=' + window.API_TOKEN)\n-    .then(r => r.text())\n-    .then(data => {\n-      document.getElementById('action_result').te