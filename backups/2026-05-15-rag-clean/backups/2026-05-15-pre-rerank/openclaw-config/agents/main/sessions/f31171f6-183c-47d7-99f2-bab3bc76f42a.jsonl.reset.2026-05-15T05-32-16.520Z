{"type":"message","id":"3f8c513f","parentId":"40b4bde6","timestamp":"2026-05-14T07:44:42.837Z","message":{"role":"toolResult","toolCallId":"call_7CsY2aUsGXKAIZUcQ1oqdEFc|fc_0d75942cb9a8c0e2016a057d6ac4a08191a8038591b68c009c","toolName":"read","content":[{"type":"text","text":"\n  <script>\n    function renderLastEventFallback() {\n      document.getElementById('last_action').textContent = 'sin datos';\n      document.getElementById('last_status').textContent = 'sin datos';\n      document.getElementById('last_duration').textContent = 'sin datos';\n    }\n\n    function renderDailySummaryFallback() {\n      document.getElementById('total').textContent = 'sin datos';\n      document.getElementById('success').textContent = 'sin datos';\n      document.getElementById('fail').textContent = 'sin datos';\n      document.getElementById('avg').textContent = 'sin datos';\n    }\n\n    function loadJson(path) {\n      return fetch(path, { cache: 'no-store' })\n        .then(response => {\n          if (!response.ok) throw new Error(`HTTP ${response.status}`);\n          return response.json();\n        });\n    }\n\n    function renderLastEvent(data) {\n      document.getElementById('last_action').textContent = data.action ?? 'sin datos';\n      document.getElementById('last_status').textContent = data.status ?? 'sin datos';\n      document.getElementById('last_duration').textContent = data.duration_ms ?? 'sin datos';\n    }\n\n    function renderDailySummary(data) {\n      document.getElementById('total').textContent = data.total ?? 'sin datos';\n      document.getElementById('success').textContent = data.success ?? 'sin datos';\n      document.getElementById('fail').textContent = data.fail ?? 'sin datos';\n      document.getElementById('avg').textContent = data.avg_duration_ms ?? 'sin datos';\n    }\n\n    function refreshDashboardData() {\n      loadJson('data/last_event.json')\n        .then(renderLastEvent)\n        .catch(error => {\n          console.error('Error cargando data/last_event.json:', error);\n          renderLastEventFallback();\n        });\n\n      loadJson('data/daily_summary.json')\n        .then(renderDailySummary)\n        .catch(error => {\n          console.error('Error cargando data/daily_summary.json:', error);\n          renderDailySummaryFallback();\n        });\n    }\n\n    refreshDashboardData();\n    setInterval(refreshDashboardData, 5000);\n  </script>\n</body>\n</html>\n"}],"isError":false,"timestamp":1778744682836}}
