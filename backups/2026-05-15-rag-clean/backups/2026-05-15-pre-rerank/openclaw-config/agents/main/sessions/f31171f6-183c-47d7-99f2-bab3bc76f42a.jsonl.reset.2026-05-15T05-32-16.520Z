{"type":"message","id":"980f0d7e","parentId":"9a7148dc","timestamp":"2026-05-14T07:37:40.866Z","message":{"role":"toolResult","toolCallId":"call_UHKeXqGAZuCL7WzvT4eIrwrS|fc_0d75942cb9a8c0e2016a057bc482288191aec87c752665f983","toolName":"read","content":[{"type":"text","text":"\n          <div class=\"mini-card compact full\" id=\"last-event\">\n            <h3>Último evento</h3>\n            <div class=\"metric\"><span>Última acción</span><strong id=\"last_action\">sin datos</strong></div>\n            <div class=\"metric\"><span>Último estado</span><strong id=\"last_status\">sin datos</strong></div>\n            <div class=\"metric\"><span>Duración</span><strong><span id=\"last_duration\">sin datos</span> ms</strong></div>\n            <div class=\"source\">\n              Fuente: <code>data/last_event.json</code><br />\n              Estado: <span class=\"pill real\">real</span>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      <div class=\"dashboard-block\">\n        <h2>Sistema documental</h2>\n        <div class=\"block-grid fill\">\n          <div class=\"mini-card compact\">\n            <h3>Tools / plugins</h3>\n            <div class=\"metric\"><span>Plugins</span><strong>sin auditoría</strong></div>\n            <div class=\"metric\"><span>Tools</span><strong>sin inventario</strong></div>\n            <div class=\"metric\"><span>Acciones</span><strong>no disponibles</strong></div>\n            <div class=\"source\">\n              Fuente futura: <code>data/metrics/tools_plugins/</code><br />\n              Estado: <span class=\"pill placeholder\">no_disponible</span>\n            </div>\n          </div>\n\n          <div class=\"mini-card compact\">\n            <h3>Fuentes locales previstas</h3>\n            <ul class=\"small\">\n              <li><code>data/metrics/</code></li>\n              <li><code>data/health/</code></li>\n              <li><code>data/snapshots/</code></li>\n              <li><code>memory/YYYY-MM-DD.md</code></li>\n            </ul>\n            <div class=\"source\">\n              Política: <span class=\"pill policy\">local</span> <span class=\"pill policy\">privado</span> <span class=\"pill policy\">read-only</span>\n            </div>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    <footer>\n      Dashboard v2 estático. Si un dato no tiene fuente verificable, se muestra como “sin datos”, “sin snapshot” o “no disponible”.\n    </footer>\n  </main>\n\n  <script>\n    function renderLastEventFallback() {\n      document.getElementById('last_action').textContent = 'sin datos';\n      document.getElementById('last_status').textContent = 'sin datos';\n      document.getElementById('last_duration').textContent = 'sin datos';\n    }\n\n    function refreshLastEvent() {\n      fetch('data/last_event.json', { cache: 'no-store' })\n        .then(response => {\n          if (!response.ok) throw new Error(`HTTP ${response.status}`);\n          return response.json();\n        })\n        .then(data => {\n          document.getElementById('last_action').textContent = data.action ?? 'sin datos';\n          document.getElementById('last_status').textContent = data.status ?? 'sin datos';\n          document.getElementById('last_duration').textContent = data.duration_ms ?? 'sin datos';\n        })\n        .catch(error => {\n          console.error('Error cargando data/last_event.json:', error);\n          renderLastEventFallback();\n        });\n    }\n\n    refreshLastEvent();\n    setInterval(refreshLastEvent, 5000);\n  </script>\n</body>\n</html>\n\n<!-- === METRICS BLOCK === -->\n<div id=\"metrics\" style=\"padding:20px;\">\n  <h2>Resumen diario</h2>\n  <p>Total: <span id=\"total\"></span></p>\n  <p>Éxitos: <span id=\"success\"></span></p>\n  <p>Fallos: <span id=\"fail\"></span></p>\n  <p>Duración media (ms): <span id=\"avg\"></span></p>\n</div>\n\n\n<script>\nfetch('/data/daily_summary.json')\n  .then(response => response.json())\n  .then(data => {\n    document.getElementById('total').textContent = data.total;\n    document.getElementById('success').textContent = data.success;\n    document.getElementById('fail').textContent = data.fail;\n    document.getElementById('avg').textContent = data.avg_duration_ms;\n  })\n  .catch(err => console.error('Error cargando JSON:', err));\n</script>\n\n\n<script>\nsetInterval(() => {\n  fetch('/data/daily_summary.json')\n    .then(response => response.json())\n    .then(data => {\n      document.getElementById('total').textContent = data.total;\n      document.getElementById('success').textContent = data.success;\n      document.getElementById('fail').textContent = data.fail;\n      document.getElementById('avg').textContent = data.avg_duration_ms;\n    });\n}, 5000);\n</script>\n"}],"isError":false,"timestamp":1778744260865}}
