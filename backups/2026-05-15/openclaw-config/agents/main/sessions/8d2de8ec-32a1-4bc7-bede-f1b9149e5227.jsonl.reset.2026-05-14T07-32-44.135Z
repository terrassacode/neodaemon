16844c0045777d","name":"write","arguments":{"path":"/openclaw/workspace/main/dashboard-v2/health/blood-pressure/index.html","content":"<!doctype html>\n<html lang=\"es\">\n<head>\n  <meta charset=\"utf-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Tensión arterial · dashboard-v2</title>\n  <style>\n    :root {\n      color-scheme: dark;\n      --bg: #0d1117;\n      --panel: #161b22;\n      --panel-2: #1f2630;\n      --text: #e6edf3;\n      --muted: #8b949e;\n      --accent: #58a6ff;\n      --border: #30363d;\n    }\n\n    * { box-sizing: border-box; }\n\n    body {\n      margin: 0;\n      font-family: system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;\n      background: var(--bg);\n      color: var(--text);\n      line-height: 1.45;\n    }\n\n    main {\n      width: min(1100px, calc(100vw - 24px));\n      margin: 0 auto;\n      padding: 18px 0 28px;\n    }\n\n    header {\n      margin-bottom: 14px;\n      display: flex;\n      justify-content: space-between;\n      gap: 14px;\n      flex-wrap: wrap;\n      align-items: flex-start;\n    }\n\n    h1 { margin: 0 0 6px; font-size: clamp(1.45rem, 3vw, 2rem); }\n    h2 { margin: 0 0 10px; color: var(--accent); font-size: 1.08rem; }\n    p { margin-top: 0; }\n    .muted { color: var(--muted); }\n\n    .panel {\n      background: var(--panel);\n      border: 1px solid var(--border);\n      border-radius: 18px;\n      padding: 14px;\n      margin-bottom: 12px;\n    }\n\n    .pill {\n      display: inline-block;\n      border-radius: 999px;\n      padding: 3px 8px;\n      font-size: .82rem;\n      background: var(--panel-2);\n      color: var(--muted);\n      border: 1px solid var(--border);\n      margin: 2px 3px 2px 0;\n    }\n\n    .actions {\n      display: flex;\n      gap: 10px;\n      align-items: center;\n      flex-wrap: wrap;\n    }\n\n    input[type=\"file\"] {\n      max-width: 100%;\n      color: var(--muted);\n      border: 1px solid var(--border);\n      border-radius: 10px;\n      padding: 8px;\n      background: var(--panel-2);\n    }\n\n    .table-wrap {\n      overflow-x: auto;\n      border: 1px solid var(--border);\n      border-radius: 14px;\n    }\n\n    table {\n      width: 100%;\n      border-collapse: collapse;\n      min-width: 720px;\n    }\n\n    th, td {\n      padding: 8px 10px;\n      border-bottom: 1px solid var(--border);\n      text-align: left;\n      vertical-align: top;\n    }\n\n    th {\n      color: var(--muted);\n      font-weight: 650;\n      background: rgba(31, 38, 48, .55);\n    }\n\n    tr:last-child td { border-bottom: 0; }\n    code {\n      background: var(--panel-2);\n      border: 1px solid var(--border);\n      border-radius: 6px;\n      padding: 1px 5px;\n      color: var(--text);\n    }\n\n    .empty {\n      color: var(--muted);\n      background: rgba(31, 38, 48, .55);\n      border: 1px dashed var(--border);\n      border-radius: 14px;\n      padding: 14px;\n    }\n\n    footer { margin-top: 14px; color: var(--muted); font-size: .9rem; }\n  </style>\n</head>\n<body>\n  <main>\n    <header>\n      <div>\n        <h1>Tensión arterial</h1>\n        <p class=\"muted\">Visualización local simple · sin gráfica · sin interpretación médica</p>\n      </div>\n      <div aria-label=\"Estado\">\n        <span class=\"pill\">HTML estático</span>\n        <span class=\"pill\">sin localStorage</span>\n        <span class=\"pill\">sin alertas clínicas</span>\n      </div>\n    </header>\n\n    <section class=\"panel\">\n      <h2>Fuente de datos</h2>\n      <p class=\"muted\">\n        Fuente esperada futura: <code>dashboard-v2/health/blood-pressure/data/**/*.jsonl</code>.\n        Esta página no lista directorios automáticamente; selecciona manualmente uno o varios archivos JSONL locales.\n      </p>\n      <div class=\"actions\">\n        <input id=\"file-input\" type=\"file\" accept=\".jsonl,application/json\" multiple />\n      </div>\n    </section>\n\n    <section class=\"panel\">\n      <h2>Registros</h2>\n      <div id=\"empty-state\" class=\"empty\">sin datos disponibles</div>\n      <div id=\"table-wrap\" class=\"table-wrap\" hidden>\n        <table>\n          <thead>\n            <tr>\n              <th>fecha/hora</th>\n              <th>systolic</th>\n              <th>diastolic</th>\n              <th>pulse</th>\n              <th>notes</th>\n            </tr>\n          </thead>\n          <tbody id=\"records-body\"></tbody>\n        </table>\n      </div>\n    </section>\n\n    <section class=\"panel\">\n      <h2>Reglas</h2>\n      <ul class=\"muted\">\n        <li>No realiza cálculos.</li>\n        <li>No realiza interpretación médica.</li>\n        <li>No genera alertas clínicas.</li>\n        <li>No usa colores clínicos.</li>\n        <li>No calcula promedios.</li>\n        <li>Si un valor es incompleto, se muestra como <code>null</code>, no como <code>0</code>.</li>\n      </ul>\n    </section>\n\n    <footer>\n      Registro privado. No sustituye criterio médico profesional.\n    </footer>\n  </main>\n\n  <script>\n    const fileInput = document.getElementById('file-input');\n    const emptyState = document.getElementById('empty-state');\n    const tableWrap = document.getElementById('table-wrap');\n    const recordsBody = document.getElementById('records-body');\n\n    function showValue(value) {\n      return value === undefined || value === null || value === '' ? 'null' : String(value);\n    }\n\n    function appendRecord(record) {\n      const row = document.createElement('tr');\n      const fields = [\n        record.timestamp,\n        record.systolic,\n        record.diastolic,\n        record.pulse,\n        record.notes\n      ];\n\n      for (const value of fields) {\n        const cell = document.createElement('td');\n        cell.textContent = showValue(value);\n        row.appendChild(cell);\n      }\n\n      recordsBody.appendChild(row);\n    }\n\n    async function readFile(file) {\n      const text = await file.text();\n      const lines = text.split(/\\r?\\n/).filter(line => line.trim().length > 0);\n\n      for (const line of lines) {\n        try {\n          const record = JSON.parse(line);\n          appendRecord(record);\n        } catch {\n          const row = document.createElement('tr');\n          const cell = document.createElement('td');\n          cell.colSpan = 5;\n          cell.textContent = 'línea JSONL inválida';\n          row.appendChild(cell);\n          recordsBody.appendChild(row);\n        }\n      }\n    }\n\n    fileInput.addEventListener('change', async () => {\n      recordsBody.textContent = '';\n\n      const files = Array.from(fileInput.files || []);\n      if (files.length === 0) {\n        emptyState.hidden = false;\n        tableWrap.hidden = true;\n        return;\n      }\n\n      for (const file of files) {\n        await readFile(file);\n      }\n\n      const hasRows = recordsBody.children.length > 0;\n      emptyState.hidden = hasRows;\n      tableWrap.hidden = !hasRows;\n    });\n  </script>\n</body>\n</html>\n"}}],"api":"openai-codex-responses","provider":"openai-codex","model":"gpt-5.5","usage":{"input":2841,"output":2373,"cacheRead":78336,"cacheWrite":0,"totalTokens":83550,"cost":{"input":0.014205,"output":0.07119,"cacheRead":0.039168,"cacheWrite":0,"total":0.12456300000000001}},"stopReason":"toolUse","timestamp":1778668728389,"responseId":"resp_079b9ccb28e0a130016a0454b96d3081919639e4cc1e342d34"}}
