n      border-color: var(--accent);\n      box-shadow: 0 0 0 1px rgba(88, 166, 255, .25);\n    }\n\n    .pill, .nav-link {\n      display: inline-block;\n      border-radius: 999px;\n      padding: 3px 8px;\n      font-size: .82rem;\n      background: var(--panel-2);\n      color: var(--muted);\n      border: 1px solid var(--border);\n      margin: 2px 3px 2px 0;\n      text-decoration: none;\n    }\n\n    .nav-link {\n      color: #9fc9ff;\n      border-color: rgba(88, 166, 255, .45);\n      background: rgba(88, 166, 255, .08);\n    }\n\n    footer { margin-top: 14px; color: var(--muted); font-size: .9rem; }\n  </style>\n</head>\n<body>\n  <main>\n    <header>\n      <div>\n        <h1>Personal</h1>\n        <p class=\"muted\">Área separada para registros personales. No mezcla salud/hábitos con métricas técnicas.</p>\n      </div>\n      <nav aria-label=\"Navegación\">\n        <a class=\"nav-link\" href=\"../index.html\">Dashboard principal</a>\n      </nav>\n    </header>\n\n    <section class=\"panel\">\n      <h2>Salud</h2>\n      <a class=\"card-link\" href=\"../health/blood-pressure/index.html\">\n        <h2>Tensión arterial</h2>\n        <p class=\"muted\">Registro local simple. Sin gráfica, sin cálculos, sin interpretación médica.</p>\n        <span class=\"pill\">local</span>\n        <span class=\"pill\">manual</span>\n        <span class=\"pill\">sin alertas clínicas</span>\n      </a>\n    </section>\n\n    <footer>\n      Sección personal estática y local. No activa sensores, servidores ni automatizaciones.\n    </footer>\n  </main>\n</body>\n</html>\n"}}],"api":"openai-codex-responses","provider":"openai-codex","model":"gpt-5.5","usage":{"input":743,"output":1118,"cacheRead":83968,"cacheWrite":0,"totalTokens":85829,"cost":{"input":0.0037150000000000004,"output":0.03354,"cacheRead":0.041984,"cacheWrite":0,"total":0.079239}},"stopReason":"toolUse","timestamp":1778669626769,"responseId":"resp_079b9ccb28e0a130016a04583b0a908191a31f05cc1238050f"}}
